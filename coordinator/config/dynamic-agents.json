{
	"schemaVersion": 1,
	"bridge": {
		"host": "127.0.0.1",
		"port": 25570,
		"secretEnvironmentVariable": "ARENA_AGENT_BRIDGE_SECRET",
		"reconnectDelayMs": 500,
		"maxReconnectDelayMs": 5000
	},
	"voice": {
		"provider": "openai",
		"openaiApiKeyEnvironmentVariable": "OPENAI_API_KEY",
		"openaiTtsModel": "gpt-4o-mini-tts",
		"openaiSttModel": "gpt-transcribe",
		"port": 8766,
		"maxConcurrent": 5,
		"profileAssignmentsPath": "runtime/voice-profile-assignments.json",
		"fishApiKeyEnvironmentVariable": "FISH_AUDIO_API_KEY",
		"deepgramApiKeyEnvironmentVariable": "DEEPGRAM_API_KEY"
	},
	"codex": {
		"controlProtocol": "native_tools",
		"planningTimeoutMs": 120000,
		"catalogTtlMs": 60000,
		"serviceTier": "priority",
		"launchProfile": {
			"model": "gpt-6-luna",
			"reasoningEffort": "xhigh",
			"serviceTier": "fast"
		}
	},
	"claude": {
		"models": ["claude-opus-5-5", "claude-sonnet-5-5", "claude-fable-5-1"],
		"reasoningEfforts": ["low", "medium", "high"],
		"planningTimeoutMs": 120000
	},
	"limits": {
		"agentCap": 16,
		"goalQueueCap": 32,
		"planningConcurrency": 16,
		"planningMode": "fixed",
		"urgentReserve": 0,
		"invalidDecisionRetries": 1
	}
}
