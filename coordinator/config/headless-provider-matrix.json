{
  "version": 1,
  "scenarios": [
    {
      "id": "codex-chat-completion",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "high",
      "serviceTier": "fast",
      "task": "Send exactly one chat message HEADLESS_CODEX_PASS, then finish the goal.",
      "timeoutMs": 180000,
      "assert": [
        { "type": "lifecycle", "state": "COMPLETED" },
        { "type": "chat", "message": "HEADLESS_CODEX_PASS" }
      ]
    },
    {
      "id": "codex-movement-chat",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "high",
      "serviceTier": "fast",
      "task": "Move one step forward and send exactly one chat message HEADLESS_MOVE_PASS, then finish the goal.",
      "timeoutMs": 180000,
      "assert": [
        { "type": "lifecycle", "state": "COMPLETED" },
        { "type": "chat", "message": "HEADLESS_MOVE_PASS" }
      ]
    },
    {
      "id": "codex-luna-xhigh-fast-wooden-pickaxe",
      "provider": "codex",
      "model": "gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "serviceTier": "fast",
      "task": "Gather wood and craft a wooden pickaxe",
      "repetitions": 3,
      "planningTimeoutMs": 120000,
      "scenarioTimeoutMs": 240000,
      "timeoutMs": 240000,
      "requireFactualSuccess": true,
      "assert": [
        { "type": "lifecycle", "state": "COMPLETED" },
        { "type": "rcon", "command": "data get entity {agent} Inventory", "match": "minecraft:wooden_pickaxe" }
      ]
    }
  ]
}
